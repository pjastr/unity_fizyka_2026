MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1879550770}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.93, g: 0.94, b: 0.96, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.05
  m_Text: "rb.AddTorque(wektor, ForceMode) \u2013 jak AddForce, ale dla obrotu. Zamiast
    masy liczy si\u0119 <b>moment bezw\u0142adno\u015Bci I</b> (Unity liczy go automatycznie
    z masy i kszta\u0142tu collider\xF3w \u2013 wida\u0107 go jako I(y)).\n\u2022
    <b>Force</b> \u2013 moment si\u0142y [N\xB7m] przez 1 s: \u03B5 = \u03C4 / I\n\u2022
    <b>Acceleration</b> \u2013 przyspieszenie k\u0105towe [rad/s\xB2] przez 1 s,
    ignoruje I\n\u2022 <b>Impulse</b> \u2013 impuls momentu [N\xB7m\xB7s]: \u0394\u03C9
    = L / I\n\u2022 <b>VelocityChange</b> \u2013 natychmiastowa zmiana \u03C9 [rad/s],
    ignoruje I\n\nWarto\u015B\u0107: 2 wok\xF3\u0142 osi Y. Prz\xF3d: ma\u0142y klocek
    1\xD71\xD71, m = 1 kg (I \u2248 0,17). Ty\u0142: du\u017Cy 2\xD72\xD72, m = 4
    kg (I \u2248 2,67).\nMa\u0142y: Force/Impulse \u2192 12 rad/s, Acceleration/VelocityChange
    \u2192 2 rad/s.\nDu\u017Cy: Force/Impulse \u2192 0,75 rad/s, Acceleration/VelocityChange
    \u2192 2 rad/s.\n\nmaxAngularVelocity podniesiono do 100 rad/s, Angular Damping
    = 0, pozycje zamro\u017Cone (Constraints)."
