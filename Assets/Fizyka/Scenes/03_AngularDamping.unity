--- !u!114 &1109792930
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1109792929}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff9ca52c25967ee44a75573485242334, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Fizyka.DemoHud
  title: "03 \xB7 Angular Damping (op\xF3r obrotu)"
  description: "<b>Angular Damping</b> (dawniej \u201EAngular Drag\u201D) \u2013
    op\xF3r ruchu obrotowego; w ka\u017Cdym kroku zmniejsza pr\u0119dko\u015B\u0107
    k\u0105tow\u0105 \u03C9. Domy\u015Blnie 0,05.\n\n<b>A. Wiruj\u0105ce klocki</b>
    (Constraints \u2192 Freeze Position, wi\u0119c tylko si\u0119 obracaj\u0105)
    dostaj\u0105 ten sam obr\xF3t \u03C9 = 15 rad/s (AddTorque, ForceMode.VelocityChange).
    Damping: 0; 0,05; 0,5; 2.\nOstatni klocek ma damping 0, ale domy\u015Blne <b>maxAngularVelocity
    = 7 rad/s</b> \u2013 Unity obcina pr\u0119dko\u015B\u0107 k\u0105tow\u0105! (pozosta\u0142e
    maj\u0105 50 rad/s, ustawione komponentem RigidbodySetup).\n\n<b>B. Tocz\u0105ce
    si\u0119 kule</b> \u2013 ta sama pr\u0119dko\u015B\u0107 pocz\u0105tkowa 6 m/s.
    Tarcie o pod\u0142o\u017Ce sprz\u0119ga obr\xF3t z ruchem, wi\u0119c wi\u0119kszy
    angular damping dzia\u0142a jak \u201Eop\xF3r toczenia\u201D \u2013 kula szybciej
    si\u0119 zatrzymuje.\n\nW kodzie: rb.angularDamping (dawniej rb.angularDrag),
    rb.maxAngularVelocity."
  sceneHint: "<b>Spacja</b> \u2013 zakr\u0119\u0107 klockami i popchnij kule"
  freeCameraControls: 1
  descriptionPanel: {fileID: 224799384}
  titleText: {fileID: 2061429100}
  descriptionText: {fileID: 1659365167}
  hintText: {fileID: 295927313}
  logPanel: {fileID: 1348827455}
  logText: {fileID: 1530422061}
  labelsRoot: {fileID: 1879550771}
  font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  showLog: 0
  maxLogLines: 12
