  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.93, g: 0.94, b: 0.96, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.05
  m_Text: "<b>Angular Damping</b> (dawniej \u201EAngular Drag\u201D) \u2013 op\xF3r
    ruchu obrotowego; w ka\u017Cdym kroku zmniejsza pr\u0119dko\u015B\u0107 k\u0105tow\u0105
    \u03C9. Domy\u015Blnie 0,05.\n\n<b>A. Wiruj\u0105ce klocki</b> (Constraints \u2192
    Freeze Position, wi\u0119c tylko si\u0119 obracaj\u0105) dostaj\u0105 ten sam
    obr\xF3t \u03C9 = 15 rad/s (AddTorque, ForceMode.VelocityChange). Damping: 0;
    0,05; 0,5; 2.\nOstatni klocek ma damping 0, ale domy\u015Blne <b>maxAngularVelocity
    = 7 rad/s</b> \u2013 Unity obcina pr\u0119dko\u015B\u0107 k\u0105tow\u0105! (pozosta\u0142e
    maj\u0105 50 rad/s, ustawione komponentem RigidbodySetup).\n\n<b>B. Tocz\u0105ce
    si\u0119 kule</b> \u2013 ta sama pr\u0119dko\u015B\u0107 pocz\u0105tkowa 6 m/s.
    Tarcie o pod\u0142o\u017Ce sprz\u0119ga obr\xF3t z ruchem, wi\u0119c wi\u0119kszy
    angular damping dzia\u0142a jak \u201Eop\xF3r toczenia\u201D \u2013 kula szybciej
    si\u0119 zatrzymuje.\n\nW kodzie: rb.angularDamping (dawniej rb.angularDrag),
    rb.maxAngularVelocity."
