MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1654927432}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.93, g: 0.94, b: 0.96, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.05
  m_Text: "<b>CharacterController</b> to kapsu\u0142a do sterowania postaci\u0105
    <b>bez Rigidbody</b>: ruch wykonuje controller.Move(), a kolizje s\u0105 rozwi\u0105zywane
    bez si\u0142 \u2013 posta\u0107 nie przewraca si\u0119 i nie odbija.\nNajwa\u017Cniejsze
    pola:\n\u2022 <b>Slope Limit</b> = 45\xB0 \u2013 maks. nachylenie, po kt\xF3rym
    da si\u0119 wej\u015B\u0107 (rampy 20\xB0, 35\xB0, 50\xB0),\n\u2022 <b>Step Offset</b>
    = 0,3 \u2013 maks. wysoko\u015B\u0107 stopnia bez skoku (schody 0,2 / 0,25 /
    0,5 m),\n\u2022 Skin Width, Min Move Distance, Center, Radius, Height.\nGrawitacj\u0119
    i skok liczymy sami w skrypcie (jak w przyk\u0142adzie PlayerController z wyk\u0142adu);
    isGrounded m\xF3wi, czy posta\u0107 stoi na pod\u0142o\u017Cu.\nCharacterController
    sam NIE pcha obiekt\xF3w z Rigidbody \u2013 robimy to w OnControllerColliderHit
    (pomara\u0144czowe skrzynie).\n\nSterowanie: WASD \u2013 ruch, Shift \u2013 bieg,
    Spacja \u2013 skok, PPM + mysz \u2013 obr\xF3t kamery, k\xF3\u0142ko \u2013 odleg\u0142o\u015B\u0107
    kamery."
