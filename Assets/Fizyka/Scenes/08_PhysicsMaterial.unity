MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1958350294}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff9ca52c25967ee44a75573485242334, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Fizyka.DemoHud
  title: "08 \xB7 Physics Material \u2013 tarcie i spr\u0119\u017Cysto\u015B\u0107"
  description: "<b>Physics Material</b> (pliki w Assets/Fizyka/PhysicsMaterials,
    przypisane w polu Material collidera) opisuje powierzchni\u0119:\n\u2022 <b>Dynamic
    Friction</b> \u2013 tarcie podczas ruchu,  \u2022 <b>Static Friction</b> \u2013
    tarcie, kt\xF3re trzeba pokona\u0107, by ruszy\u0107,\n\u2022 <b>Bounciness</b>
    \u2013 spr\u0119\u017Cysto\u015B\u0107 (0 = glina, 1 = idealne odbicie),\n\u2022
    <b>Friction / Bounce Combine</b> \u2013 jak \u0142\u0105czy\u0107 warto\u015Bci
    dw\xF3ch materia\u0142\xF3w: Average, Minimum, Multiply, Maximum (przy r\xF3\u017Cnych
    trybach wygrywa wy\u017Cszy priorytet: Average < Minimum < Multiply < Maximum).\n\n<b>A.
    Rampa 25\xB0</b> (Spacja zdejmuje blokad\u0119): L\xF3d (0/0) zje\u017Cd\u017Ca
    szybko, Drewno (0,3/0,35) wolniej, Guma (0,9/1) stoi. Ostatni: Static 0,8 / Dynamic
    0,1 \u2013 stoi, ale szturchni\u0119ty LPM zje\u017Cd\u017Ca szybko! (tan 25\xB0
    \u2248 0,47)\nRampa ma tarcie 1 i Combine = Minimum, wi\u0119c decyduje materia\u0142
    klocka.\n\n<b>B. Odbicia</b> \u2013 kule z Bounciness 0; 0,25; 0,5; 0,8; 1 (Bounce
    Combine = Maximum).\n\n<b>C. Combine</b> \u2013 4 klocki z lodu (tarcie 0) pchni\u0119te
    z 6 m/s po gumie (0,9) z r\xF3\u017Cnym Friction Combine: Average \u2192 0,45
    \xB7 Minimum \u2192 0 \xB7 Multiply \u2192 0 \xB7 Maximum \u2192 0,9."
  sceneHint: "<b>Spacja</b> \u2013 zdejmij blokad\u0119, zrzu\u0107 kule, pchnij
    klocki"
  freeCameraControls: 1
  descriptionPanel: {fileID: 1763912342}
  titleText: {fileID: 1496951202}
  descriptionText: {fileID: 1614114300}
  hintText: {fileID: 589733486}
