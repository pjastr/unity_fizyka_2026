--- !u!114 &2063726887
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2063726884}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.93, g: 0.94, b: 0.96, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.05
  m_Text: "<b>Collision Detection</b> okre\u015Bla, jak wykrywane s\u0105 kolizje
    szybkich obiekt\xF3w:\n\u2022 <b>Discrete</b> (domy\u015Blny) \u2013 sprawdza
    tylko pozycje w kolejnych krokach. Kulka 120 m/s przy kroku 0,02 s przesuwa si\u0119
    o 2,4 m na krok \u2013 mo\u017Ce \u201Eprzeskoczy\u0107\u201D cienk\u0105 (10
    cm) \u015Bcian\u0119 = <b>tunelowanie</b>.\n\u2022 <b>Continuous</b> \u2013 ci\u0105g\u0142e
    wykrywanie (CCD) wzgl\u0119dem collider\xF3w statycznych.\n\u2022 <b>Continuous
    Dynamic</b> \u2013 CCD tak\u017Ce wzgl\u0119dem innych cia\u0142 z trybem Continuous
    / Continuous Dynamic (najdro\u017Cszy).\n\u2022 <b>Continuous Speculative</b>
    \u2013 ta\u0144sze, \u201Eprzewiduj\u0105ce\u201D kontakty; dzia\u0142a te\u017C
    dla obrot\xF3w i kinematyk\xF3w, czasem daje fa\u0142szywe (\u201Educhowe\u201D)
    kontakty.\n\nSpacja \u2013 strza\u0142 z 4 wyrzutni w cienk\u0105 \u015Bcian\u0119.
    Wynik pojawia si\u0119 w dzienniku i nad wyrzutni\u0105. Kilka strza\u0142\xF3w
    pokazuje, \u017Ce Discrete prawie zawsze przenika.\n\nRada: tryb ci\u0105g\u0142y
    tylko dla ma\u0142ych, szybkich obiekt\xF3w (pociski) \u2013 kosztuje wydajno\u015B\u0107."
