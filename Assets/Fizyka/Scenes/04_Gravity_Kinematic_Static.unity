MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 384328135}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.93, g: 0.94, b: 0.96, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.05
  m_Text: "Obiekt fizyczny mo\u017Ce by\u0107:\n\u2022 <b>dynamiczny</b> \u2013 Rigidbody,
    pe\u0142na symulacja (si\u0142y, grawitacja, zderzenia),\n\u2022 <b>kinematyczny</b>
    \u2013 Rigidbody z <b>Is Kinematic</b>: ruszany tylko skryptem (MovePosition/MoveRotation),
    ignoruje si\u0142y i zderzenia, ale PCHA cia\u0142a dynamiczne,\n\u2022 <b>statyczny</b>
    \u2013 sam Collider bez Rigidbody (pod\u0142oga, \u015Bciany).\nTo odpowiednik
    typ\xF3w Dynamic / Kinematic / Static z Rigidbody2D.\n\nSpacja \u2013 wyrzutnie
    strzelaj\u0105 w 4 cele (od lewej):\n1. Dynamic + Use Gravity \u2013 spada z
    podstawy,\n2. Dynamic, Use Gravity = off \u2013 odlatuje i dryfuje w powietrzu,\n3.
    Is Kinematic \u2013 ani drgnie, kulka si\u0119 odbija,\n4. Static (brak Rigidbody)
    \u2013 te\u017C nieruchomy.\n\nZ ty\u0142u: kinematyczne rami\u0119 (MoveRotation)
    zmiata dynamiczne klocki, a przez statyczny s\u0142upek po prostu przenika.\nZasada:
    ruchome obiekty przesuwaj przez Rigidbody (kinematic + MovePosition), a nie przez
    transform statycznego collidera."
