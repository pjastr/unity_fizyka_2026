  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff9ca52c25967ee44a75573485242334, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Fizyka.DemoHud
  title: "04 \xB7 Use Gravity / Is Kinematic / Static"
  description: "Obiekt fizyczny mo\u017Ce by\u0107:\n\u2022 <b>dynamiczny</b> \u2013
    Rigidbody, pe\u0142na symulacja (si\u0142y, grawitacja, zderzenia),\n\u2022 <b>kinematyczny</b>
    \u2013 Rigidbody z <b>Is Kinematic</b>: ruszany tylko skryptem (MovePosition/MoveRotation),
    ignoruje si\u0142y i zderzenia, ale PCHA cia\u0142a dynamiczne,\n\u2022 <b>statyczny</b>
    \u2013 sam Collider bez Rigidbody (pod\u0142oga, \u015Bciany).\nTo odpowiednik
    typ\xF3w Dynamic / Kinematic / Static z Rigidbody2D.\n\nSpacja \u2013 wyrzutnie
    strzelaj\u0105 w 4 cele (od lewej):\n1. Dynamic + Use Gravity \u2013 spada z
    podstawy,\n2. Dynamic, Use Gravity = off \u2013 odlatuje i dryfuje w powietrzu,\n3.
    Is Kinematic \u2013 ani drgnie, kulka si\u0119 odbija,\n4. Static (brak Rigidbody)
    \u2013 te\u017C nieruchomy.\n\nZ ty\u0142u: kinematyczne rami\u0119 (MoveRotation)
    zmiata dynamiczne klocki, a przez statyczny s\u0142upek po prostu przenika.\nZasada:
    ruchome obiekty przesuwaj przez Rigidbody (kinematic + MovePosition), a nie przez
    transform statycznego collidera."
  sceneHint: "<b>Spacja</b> \u2013 strza\u0142 w cele"
  freeCameraControls: 1
  descriptionPanel: {fileID: 951555063}
  titleText: {fileID: 1132493095}
  descriptionText: {fileID: 384328138}
  hintText: {fileID: 1557786772}
  logPanel: {fileID: 1828987337}
  logText: {fileID: 2051403548}
  labelsRoot: {fileID: 1355699390}
  font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  showLog: 0
  maxLogLines: 12
